{
  "name": "cover-mga-backoffice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "backend:restore": "dotnet restore backend/BackOffice.slnx --configfile NuGet.Config --packages .local/nuget --locked-mode",
    "backend:build": "dotnet build backend/BackOffice.slnx --no-restore",
    "test:backend": "dotnet test backend/BackOffice.slnx --no-restore",
    "web:build": "pnpm --filter @cover/backoffice build",
    "web:typecheck": "pnpm --filter @cover/backoffice typecheck",
    "test": "node --test tests/*.test.mjs",
    "design:extract": "node scripts/extract-prototype.mjs && node scripts/inspect-prototype.mjs && node scripts/build-design-inventory.mjs",
    "contracts:generate": "node scripts/generate-policy-contracts.mjs && node scripts/generate-underwriting-contracts.mjs && node scripts/generate-openapi.mjs && node scripts/generate-adapter-contracts.mjs",
    "contracts:validate": "node scripts/lint-openapi.mjs && node --test tests/policy-contracts.test.mjs tests/api-contracts.test.mjs tests/adapter-contracts.test.mjs",
    "web:lint": "pnpm --filter @cover/backoffice lint",
    "web:test": "pnpm --filter @cover/backoffice test",
    "web:browser": "node scripts/verify-shell-browser.mjs",
    "web:browser:operations": "node scripts/verify-operations-browser.mjs",
    "web:browser:clients": "node scripts/verify-clients-browser.mjs",
    "web:browser:contacts": "node scripts/verify-contacts-browser.mjs",
    "web:browser:support": "node scripts/verify-support-flags-browser.mjs",
    "web:browser:matches": "node scripts/verify-matches-browser.mjs",
    "web:browser:agencies": "node scripts/verify-agency-suite.mjs",
    "web:browser:quotes": "node scripts/verify-quote-suite.mjs",
    "web:browser:underwriting": "node scripts/verify-underwriting-suite.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.52.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "playwright": "1.62.1"
  }
}
