{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cover-mga.example/quote-draft/1.0",
  "title": "Incomplete Motor Trade capture write shape",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "productCode": {
      "enum": [
        "motor-trade-road-risks",
        "motor-trade-combined"
      ]
    },
    "insured": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entityType": {
          "type": "string",
          "enum": [
            "sole-trader",
            "partnership",
            "limited-company",
            "llp"
          ]
        },
        "legalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tradingName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "companyNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "address": {
          "$ref": "#/$defs/Address"
        },
        "proposerNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 0,
          "maxItems": 3
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "telephone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "mobile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            }
          }
        },
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "surname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "title": {
          "$ref": "#/$defs/Reference"
        },
        "declaredCompanyType": {
          "$ref": "#/$defs/Reference"
        },
        "responses": {
          "$ref": "#/$defs/Responses"
        }
      }
    },
    "termIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "annual",
            "short-period"
          ]
        },
        "localStartDate": {
          "$ref": "#/$defs/Date"
        },
        "localStartTime": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "timeZone": {
          "const": "Europe/London"
        },
        "utcOffsetMinutes": {
          "type": "integer",
          "enum": [
            0,
            60
          ]
        },
        "localEndDate": {
          "$ref": "#/$defs/Date"
        },
        "localEndTime": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "endUtcOffsetMinutes": {
          "type": "integer",
          "enum": [
            0,
            60
          ]
        }
      }
    },
    "risk": {
      "$ref": "#/$defs/RoadRisk"
    },
    "cover": {
      "$ref": "#/$defs/Cover"
    }
  },
  "$defs": {
    "Id": {
      "type": "string",
      "format": "uuid"
    },
    "Date": {
      "type": "string",
      "format": "date"
    },
    "Instant": {
      "type": "string",
      "format": "date-time"
    },
    "Amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,12})\\.[0-9]{2}$"
    },
    "Reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "collection",
        "value",
        "label",
        "version"
      ]
    },
    "Address": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "line2": {
          "type": "string",
          "maxLength": 200
        },
        "town": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "county": {
          "type": "string",
          "maxLength": 100
        },
        "postcode": {
          "type": "string",
          "pattern": "^[A-Z0-9 ]{5,10}$"
        },
        "country": {
          "const": "GB"
        },
        "houseNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "street": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "Answer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "questionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "questionId",
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "questionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "kind": {
              "const": "text"
            },
            "value": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "required": [
            "questionId",
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "questionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "kind": {
              "const": "date"
            },
            "value": {
              "$ref": "#/$defs/Date"
            }
          },
          "required": [
            "questionId",
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "questionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "kind": {
              "const": "count"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          },
          "required": [
            "questionId",
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "questionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "kind": {
              "const": "money"
            },
            "value": {
              "$ref": "#/$defs/Amount"
            },
            "currency": {
              "const": "GBP"
            }
          },
          "required": [
            "questionId",
            "kind",
            "value",
            "currency"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "questionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "kind": {
              "const": "reference"
            },
            "value": {
              "$ref": "#/$defs/Reference"
            }
          },
          "required": [
            "questionId",
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "questionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "kind": {
              "const": "references"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Reference"
              },
              "minItems": 0,
              "maxItems": 1000
            }
          },
          "required": [
            "questionId",
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "questionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "kind": {
              "const": "percentage"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "unit": {
              "const": "basis-points"
            }
          },
          "required": [
            "questionId",
            "kind",
            "value",
            "unit"
          ]
        }
      ]
    },
    "Responses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "questionSetVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "answers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Answer"
          },
          "minItems": 0,
          "maxItems": 1000
        }
      }
    },
    "Activity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "code": {
          "$ref": "#/$defs/Reference"
        },
        "turnoverBasisPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "id"
      ]
    },
    "Loss": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "occurredOn": {
          "$ref": "#/$defs/Date"
        },
        "type": {
          "$ref": "#/$defs/Reference"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "amount": {
          "$ref": "#/$defs/Amount"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "closed",
            "notification-only"
          ]
        },
        "fault": {
          "type": "string",
          "enum": [
            "fault",
            "non-fault",
            "unknown",
            "split"
          ]
        },
        "riskItemId": {
          "$ref": "#/$defs/Id"
        },
        "responses": {
          "$ref": "#/$defs/Responses"
        },
        "declaredStatus": {
          "$ref": "#/$defs/Reference"
        },
        "declaredType": {
          "$ref": "#/$defs/Reference"
        }
      },
      "required": [
        "id"
      ]
    },
    "Conviction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "occurredOn": {
          "$ref": "#/$defs/Date"
        },
        "code": {
          "$ref": "#/$defs/Reference"
        },
        "fine": {
          "$ref": "#/$defs/Amount"
        },
        "points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "banMonths": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1200
        },
        "responses": {
          "$ref": "#/$defs/Responses"
        },
        "disqualified": {
          "type": "boolean"
        },
        "declaredBanPeriod": {
          "type": "string",
          "enum": [
            "none",
            "under-3-months",
            "3-to-6-months",
            "6-to-12-months",
            "over-12-months"
          ]
        }
      },
      "required": [
        "id"
      ]
    },
    "Driver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "surname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "dateOfBirth": {
          "$ref": "#/$defs/Date"
        },
        "address": {
          "$ref": "#/$defs/Address"
        },
        "relationship": {
          "$ref": "#/$defs/Reference"
        },
        "usage": {
          "$ref": "#/$defs/Reference"
        },
        "licence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "$ref": "#/$defs/Reference"
            },
            "number": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "testDate": {
              "$ref": "#/$defs/Date"
            },
            "issuedOn": {
              "$ref": "#/$defs/Date"
            }
          }
        },
        "convictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Conviction"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "losses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Loss"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "responses": {
          "$ref": "#/$defs/Responses"
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "occupations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DriverOccupation"
          },
          "minItems": 0,
          "maxItems": 5
        },
        "criminalConvictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CriminalConviction"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "countyCourtJudgments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CountyCourtJudgment"
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [
        "id"
      ]
    },
    "Vehicle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "registration": {
          "type": "string",
          "pattern": "^[A-Z0-9 ]{2,12}$"
        },
        "make": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "manufactureYear": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2200
        },
        "body": {
          "$ref": "#/$defs/Reference"
        },
        "ownership": {
          "type": "string",
          "enum": [
            "business-owned",
            "stock-for-sale",
            "driver-personal",
            "customer"
          ]
        },
        "ownerDriverId": {
          "$ref": "#/$defs/Id"
        },
        "value": {
          "$ref": "#/$defs/Amount"
        },
        "purchasePrice": {
          "$ref": "#/$defs/Amount"
        },
        "purchasedOn": {
          "$ref": "#/$defs/Date"
        },
        "grossWeightKg": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "engineCc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "responses": {
          "$ref": "#/$defs/Responses"
        },
        "modifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VehicleModification"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "abiCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "abiGroup": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "vehicleType": {
          "$ref": "#/$defs/Reference"
        },
        "bodyDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "seats": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "doors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "fuelType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "transmission": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "declaredEngineSize": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "registrationYear": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2200
        },
        "registeredOn": {
          "$ref": "#/$defs/Date"
        },
        "imported": {
          "type": "boolean"
        },
        "declaredOwnerType": {
          "$ref": "#/$defs/Reference"
        },
        "keptOvernightType": {
          "$ref": "#/$defs/Reference"
        },
        "keptOvernightAddress": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "partOfLeaseAgreement": {
          "type": "boolean"
        },
        "leaseLengthYears": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "customerLoan": {
          "type": "boolean"
        },
        "modified": {
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ]
    },
    "Premises": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "address": {
          "$ref": "#/$defs/Address"
        },
        "use": {
          "$ref": "#/$defs/Reference"
        },
        "security": {
          "$ref": "#/$defs/Reference"
        },
        "buildings": {
          "$ref": "#/$defs/Amount"
        },
        "contents": {
          "$ref": "#/$defs/Amount"
        },
        "responses": {
          "$ref": "#/$defs/Responses"
        },
        "yearsTrading": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "sharedWorksite": {
          "type": "boolean"
        },
        "declaredUse": {
          "$ref": "#/$defs/Reference"
        }
      },
      "required": [
        "id"
      ]
    },
    "Business": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "startedOn": {
          "$ref": "#/$defs/Date"
        },
        "turnover": {
          "$ref": "#/$defs/Amount"
        },
        "wageRoll": {
          "$ref": "#/$defs/Amount"
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Activity"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "responses": {
          "$ref": "#/$defs/Responses"
        },
        "declaredActivitySplit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sales": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "servicing": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "mechanicalRepair": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "breakdownRecovery": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "bodyRepairs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "valeting": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "other": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          }
        }
      }
    },
    "PreviousInsurance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "insurer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expiresOn": {
          "$ref": "#/$defs/Date"
        },
        "noClaimsYears": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "responses": {
          "$ref": "#/$defs/Responses"
        },
        "noClaimsYearsBasis": {
          "type": "string",
          "enum": [
            "exact",
            "at-least"
          ]
        },
        "policyNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "policyholderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "noClaimsBonusExpiresOn": {
          "$ref": "#/$defs/Date"
        }
      }
    },
    "DriverBasis": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "named"
            },
            "responses": {
              "$ref": "#/$defs/Responses"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "any-driver"
            },
            "minimumAge": {
              "type": "integer",
              "minimum": 16,
              "maximum": 100
            },
            "maximumAge": {
              "type": "integer",
              "minimum": 16,
              "maximum": 100
            },
            "maximumWeightKg": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "maximumEngineCc": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "driverCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "responses": {
              "$ref": "#/$defs/Responses"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "RoadRisk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "business": {
          "$ref": "#/$defs/Business"
        },
        "driverBasis": {
          "$ref": "#/$defs/DriverBasis"
        },
        "drivers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Driver"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "vehicles": {
          "type": "array",
          "items": {
